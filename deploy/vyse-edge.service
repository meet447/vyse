[Unit]
Description=Vyse edge gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStart=/usr/local/bin/vyse-edge --quic 0.0.0.0:4433 --http 127.0.0.1:8080 --http3 127.0.0.1:8443 --domain vyse.chipling.xyz --public-base https://vyse.chipling.xyz --claims /var/lib/vyse/claims.db
Restart=always
RestartSec=2
Environment=RUST_LOG=info
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
