{
	on_demand_tls {
		ask http://127.0.0.1:2025/ok
	}
}

# Allow Let's Encrypt on-demand certs only for Vyse hostnames.
:2025 {
	bind 127.0.0.1
	@allow expression `{query.domain}.endsWith(".vyse.chipling.xyz") || {query.domain} == "vyse.chipling.xyz"`
	handle @allow {
		respond 200
	}
	respond 400
}

api.koraku.chipling.xyz {
	encode gzip zstd
	reverse_proxy 127.0.0.1:8000
}

vyse.chipling.xyz {
	tls {
		on_demand
	}
	header Content-Type "text/plain; charset=utf-8"
	respond `Vyse edge is live.

Open a tunnel from your laptop:

  cargo run -p vyse-cli -- tunnel --edge vyse.chipling.xyz:4433 --subdomain my-app --port 3000

Then visit:

  https://my-app.vyse.chipling.xyz
`
}

*.vyse.chipling.xyz {
	tls {
		on_demand
	}
	encode gzip zstd
	reverse_proxy 127.0.0.1:8080
}
